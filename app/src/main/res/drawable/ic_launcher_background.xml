                    android:color="#FF0B1120"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Resplandor de acento superior derecho (Indigo) -->
    <path android:pathData="M78,30m-20,0a20,20 0 1,0 40,0a20,20 0 1,0 -40,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="78"
                android:centerY="30"
                android:gradientRadius="20"
                android:type="radial">
                <item
                    android:color="#337C83FF"
                    android:offset="0.0" />
                <item
                    android:color="#00000000"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Resplandor de acento inferior izquierdo (Rosa) -->
    <path android:pathData="M30,78m-20,0a20,20 0 1,0 40,0a20,20 0 1,0 -40,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="30"
                android:centerY="78"
                android:gradientRadius="20"
                android:type="radial">
                <item
                    android:color="#25F472B6"
                    android:offset="0.0" />
                <item
                    android:color="#00000000"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
